# AeroMESH environment template.
#
# Copy to `.env` (which is gitignored) and fill in real values, or simply run
# `pwsh ./start.ps1` once — it generates cryptographically random 32-byte hex
# secrets and writes `.env` for you.
#
#   Copy-Item .env.example .env
#
# `.env` is loaded by both the Rust engine (`load_dotenv_if_present`) and the
# FastAPI gateway (`load_dotenv`). Existing process environment variables always
# win over the file in both loaders.

# --- Required: cluster authentication -------------------------------------
# Bearer token required by the Axum coordinator API (port 8080).
# Generate with: pwsh -c "[Convert]::ToHexString((1..32|%{Get-Random -Max 256}))"
AEROMESH_API_KEY=

# Shared secret for the mutual worker handshake (port 50052).
# Hashed with SHA-256 into the 32-byte handshake token.
# If this is empty, both sides authenticate against SHA-256("") — set it.
AEROMESH_WORKER_SECRET=

# --- Optional: activation wire codec --------------------------------------
# One of: bf16 (default) | int8 | fp8 | fp16 | rawf32
#   rawf32 -> 4 bytes/element, no compression (useful for numerical debugging)
#   fp16    -> 2 bytes/element
#   bf16    -> 2 bytes/element (default)
#   int8    -> ~1 byte/element (per-row dynamic scaling)
#   fp8     -> 1 byte/element (E4M3)
AEROMESH_ACTIVATION_DTYPE=bf16

# --- Optional: web gateway ------------------------------------------------
# Bind address/port and upstream coordinator URL for `app.py`.
# AEROMESH_UI_HOST=127.0.0.1
# AEROMESH_UI_PORT=7860
# AEROMESH_BACKEND_URL=http://127.0.0.1:8080

# Extra bearer required from *non-loopback* clients hitting the gateway.
# When unset, the gateway only accepts loopback clients.
# AEROMESH_GATEWAY_API_KEY=

# --- Optional: CORS for the coordinator API -------------------------------
# Comma-separated extra origins allowed to call the Axum API from a browser.
# AEROMESH_ALLOWED_ORIGIN=
