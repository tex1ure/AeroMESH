# Rust build output & dependencies
target/
**/*.rs.bk

# NOTE: Cargo.lock IS tracked on purpose. AeroMESH ships a binary (the `aeromesh`
# CLI) plus native FFI bindings, so reproducible dependency resolution matters
# more than the library-style "don't commit the lockfile" convention.

# Python virtual environment, caches & packages
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local binary builds, native DLLs & submodules
llama.cpp/
build/
bin/*.exe
bin/*.dll
bin/*.lib
bin/*.pdb
bin/*.so
bin/*.dylib
# MinGW import libraries generated from the DLLs by setup.ps1 (dlltool).
bin/*.dll.a
bin/*-import.def
*.exe
*.dll
*.lib
*.pdb
*.so
*.dylib

# Large AI Model Weights & Tensors (Pre-staged locally on NVMe)
models/*.gguf
*.gguf
*.bin
*.safetensors
*.pt
*.onnx

# Video & Large Media Demo Recordings (> 50MB)
*.mp4
*.mkv
*.mov
*.avi
*.webm

# AeroMESH Shared Memory Buffers & Runtime Logs
# NOTE: SHM ring buffers live under %TEMP%\aeromesh_shm (see aeromesh-core/src/transport.rs),
# not in the repo; these patterns are kept for in-tree debugging runs.
*.log
logs/
aeromesh_shm/
channel_*_fwd.bin
channel_*_bwd.bin

# IDE, Editor & OS metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Environment variables & secrets
.env
.env.*
!.env.example

# Fixes files
apply_fixes.py

